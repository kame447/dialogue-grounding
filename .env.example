# Preferred mode: route through a dedicated Cloudflare Worker.
RESEARCH_AI_PROVIDER=cloudflare
RESEARCH_AI_BASE_URL=https://your-research-worker.workers.dev/v1
RESEARCH_AI_MODEL=
# The Worker access token (NOT the upstream OpenAI/Gemini API key).
RESEARCH_PROXY_TOKEN=

# The actual upstream API key is stored ONLY in the Worker secret
# UPSTREAM_API_KEY using Wrangler. Do not place it in this file.
# For direct connection testing only, change provider to openai or gemini:
# RESEARCH_AI_PROVIDER=openai
# RESEARCH_AI_API_KEY=

# RESEARCH_AI_TIMEOUT_MS=45000
# RESEARCH_AI_MAX_COMPLETION_TOKENS=400
