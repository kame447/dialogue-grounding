# Copy to .env, then add the key locally. Never commit .env.
RESEARCH_AI_PROVIDER=openai
RESEARCH_AI_MODEL=
RESEARCH_AI_API_KEY=
# Only necessary for RESEARCH_AI_PROVIDER=custom (or to override defaults)
# RESEARCH_AI_BASE_URL=https://your-openai-compatible-endpoint/v1
# RESEARCH_AI_TIMEOUT_MS=45000
# RESEARCH_AI_MAX_COMPLETION_TOKENS=400
