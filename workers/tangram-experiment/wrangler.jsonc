{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tangram-grounding-experiment",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NAMING_SESSIONS",
        "class_name": "TangramSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TangramSession"
      ]
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "AI_PROXY",
      "service": "dialogue-grounding-ai-proxy",
      "entrypoint": "InternalResearchProxy"
    }
  ]
}
