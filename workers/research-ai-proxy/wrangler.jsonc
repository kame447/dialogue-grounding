{
  "name": "dialogue-grounding-ai-proxy",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "vars": {
    "UPSTREAM_PROVIDER": "openai",
    "MAX_COMPLETION_TOKENS": "1024",
    "DIALOGUE_MODEL": "gpt-4o-mini"
  }
}
