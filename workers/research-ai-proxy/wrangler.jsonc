{
  "name": "dialogue-grounding-ai-proxy",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "vars": {
    "UPSTREAM_PROVIDER": "openai",
    "MAX_COMPLETION_TOKENS": "8192",
    "DIALOGUE_MODEL": "gpt-6-luna",
    "RESEARCH_DECISIONS_ENABLED": "true"
  }
}
